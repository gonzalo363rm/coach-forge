# PostgreSQL (Prisma). Obligatoria en Vercel/runtime; en build local usa fallback del prisma.config.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coach_forge?schema=public"

# NextAuth (Auth.js). Genera con: npx auth secret
AUTH_SECRET=""

# Email (Resend). Sin estas variables, en dev el enlace se imprime en consola.
RESEND_API_KEY=""
EMAIL_FROM="Coach Forge <onboarding@resend.dev>"

# Cloudinary (imágenes). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""