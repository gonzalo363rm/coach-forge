NODE_ENV="development"

# PostgreSQL (Prisma). Obligatoria en Vercel/runtime; en build local usa fallback del prisma.config.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/coach_forge?schema=public"

# NextAuth (Auth.js). Genera con: npx auth secret
AUTH_SECRET=""

# Email (Resend). Sin estas variables, en dev el enlace se imprime en consola.
RESEND_API_KEY=""
EMAIL_FROM="Coach Forge <onboarding@resend.dev>"

# Cloudinary (imágenes). Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Carpetas: coach-forge/{development|production}/avatars|exercises|elements (según NODE_ENV)
CLOUDINARY_URL=""

# URL pública de la app (emails, SEO). En local: http://localhost:3000
APP_URL="http://localhost:3000"

# Mercado Pago Checkout Pro (Access Token de prueba o producción)
MP_ACCESS_TOKEN=""
# URL pública accesible por MP (ngrok, deploy). Obligatoria en local para webhooks y auto_return.
# Ej: https://abc123.ngrok-free.app
MP_PUBLIC_APP_URL=""

# Días de gracia tras el vencimiento antes de bajar al plan Free (default: 7)
BILLING_GRACE_DAYS="7"