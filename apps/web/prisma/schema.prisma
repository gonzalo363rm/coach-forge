generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sportId    String?
  title      String
  minPlayers Int?
  maxPlayers Int?
  difficulty Int
  videoLink  String?
  canvas     Json

  sport      Sport?   @relation(fields: [sportId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([sportId])
}

model Sport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  slug      String

  exercises Exercise[]
  elements  Element[]
}

model Element {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sportId   String?
  name      String
  type      String   @default("image")
  image     String
  width     Float
  height    Float

  sport Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sportId])
}
