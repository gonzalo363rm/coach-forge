generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin
  club_manager
  coach
}

enum ContentVisibility {
  private
  club
  public
}

enum AuthTokenType {
  email_verification
  password_reset
}

enum CatalogStatus {
  active
  inactive
}

enum PlanType {
  individual
  club
}

enum PlanCatalogRole {
  none
  free
  full
}

enum DurationUnit {
  month
  year
}

enum PermissionValueKind {
  flag
  limit
}

enum DiscountType {
  percentage
  fixed
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum PaymentProvider {
  mercado_pago
}

enum PaymentMethod {
  credit_card
  debit_card
  account_money
  ticket
  bank_transfer
  other
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
}

model Club {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  address    String?
  logoUrl    String?
  maxMembers Int      @default(20)
  managerId  String   @unique

  manager User  @relation("ClubManager", fields: [managerId], references: [id], onDelete: Cascade)
  members User[] @relation("ClubMembers")

  @@index([managerId])
}

model Exercise {
  id         String            @id @default(uuid())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  sportId    String?
  title      String
  minPlayers Int?
  maxPlayers Int?
  difficulty Int
  videoLink  String?
  canvas     Json
  visibility ContentVisibility @default(private)
  creatorId  String?

  sport              Sport?                  @relation(fields: [sportId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator            User?                   @relation(fields: [creatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  trainingClassItems TrainingClassExercise[]

  @@index([sportId])
  @@index([creatorId])
  @@index([visibility])
}

model TrainingClass {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  title       String
  description String?
  sportId     String?
  difficulty  Int
  visibility  ContentVisibility @default(private)
  creatorId   String?

  sport   Sport?                  @relation(fields: [sportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creator User?                   @relation(fields: [creatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items   TrainingClassExercise[]

  @@index([sportId])
  @@index([creatorId])
  @@index([visibility])
}

model TrainingClassExercise {
  id              String  @id @default(uuid())
  trainingClassId String
  exerciseId      String
  sortOrder       Int
  durationMinutes Int?
  isOptional      Boolean @default(false)

  trainingClass TrainingClass @relation(fields: [trainingClassId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([trainingClassId, exerciseId])
  @@index([trainingClassId, sortOrder])
}

model Sport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  slug      String

  exercises       Exercise[]
  elements        Element[]
  trainingClasses TrainingClass[]
}

model Element {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sportId   String?
  name      String
  type      String   @default("image")
  image     String
  width     Float
  height    Float

  sport Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sportId])
}

model User {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  phoneNumber   String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role               Role      @default(coach)
  avatarUrl          String?
  clubId             String?
  clubAccessEnabled  Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  club            Club?           @relation("ClubMembers", fields: [clubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  managedClub     Club?           @relation("ClubManager")
  authTokens      AuthToken[]
  exercises       Exercise[]
  trainingClasses TrainingClass[]
  subscriptions   Subscription[]

  @@index([clubId])
  @@index([role])
}

model AuthToken {
  userId  String
  type    AuthTokenType
  token   String        @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model Permission {
  id                String              @id @default(uuid())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  code              String              @unique
  name              String
  description       String?
  valueKind         PermissionValueKind
  appliesToPlanType PlanType?
  status            CatalogStatus       @default(active)

  planPermissions PlanPermission[]

  @@index([status])
}

model Plan {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  name        String
  description String?
  type        PlanType
  catalogRole PlanCatalogRole @default(none)
  status      CatalogStatus   @default(active)

  permissions   PlanPermission[]
  offers        PlanOffer[]
  subscriptions Subscription[]

  @@index([type])
  @@index([status])
  @@index([catalogRole])
}

model PlanPermission {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  planId       String
  permissionId String
  value        Int?

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([planId, permissionId])
  @@index([planId])
  @@index([permissionId])
}

model PlanOffer {
  id            String        @id @default(uuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  planId        String
  name          String
  durationValue Int
  durationUnit  DurationUnit
  price         Decimal       @db.Decimal(12, 2)
  currency      String        @default("ARS")
  validFrom     DateTime?
  validUntil    DateTime?
  status        CatalogStatus @default(active)

  plan          Plan                @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  discounts     PlanOfferDiscount[]
  subscriptions Subscription[]

  @@index([planId])
  @@index([status])
}

model Discount {
  id         String        @id @default(uuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  name       String
  type       DiscountType
  value      Decimal       @db.Decimal(12, 2)
  code       String?       @unique
  validFrom  DateTime?
  validUntil DateTime?
  maxUses    Int?
  status     CatalogStatus @default(active)

  planOffers    PlanOfferDiscount[]
  subscriptions Subscription[]

  @@index([status])
}

model PlanOfferDiscount {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  planOfferId String
  discountId  String

  planOffer PlanOffer @relation(fields: [planOfferId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  discount  Discount  @relation(fields: [discountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([planOfferId, discountId])
  @@index([planOfferId])
  @@index([discountId])
}

model Subscription {
  id                  String             @id @default(uuid())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  userId              String
  planId              String
  planOfferId         String?
  discountId          String?
  planName            String
  offerName           String?
  durationValue       Int
  durationUnit        DurationUnit
  originalPrice       Decimal            @db.Decimal(12, 2)
  discountAmount      Decimal            @default(0) @db.Decimal(12, 2)
  finalPrice          Decimal            @db.Decimal(12, 2)
  currency            String             @default("ARS")
  permissionsSnapshot Json
  startDate           DateTime
  endDate             DateTime
  status              SubscriptionStatus @default(pending)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planOffer PlanOffer? @relation(fields: [planOfferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  discount  Discount?  @relation(fields: [discountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payments  Payment[]

  @@index([userId])
  @@index([planId])
  @@index([planOfferId])
  @@index([status])
  @@index([endDate])
}

model Payment {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptionId  String
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("ARS")
  provider        PaymentProvider @default(mercado_pago)
  status          PaymentStatus   @default(pending)
  paymentMethod   PaymentMethod?
  preferenceId    String?         @unique
  externalId      String?         @unique
  merchantOrderId String?
  providerStatus  String?
  providerPayload Json?
  paidAt          DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([subscriptionId])
  @@index([status])
}
