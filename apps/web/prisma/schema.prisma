generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin
  club_manager
  coach
}

enum ContentVisibility {
  private
  club
  public
}

enum AuthTokenType {
  email_verification
  password_reset
}

model Club {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  address    String?
  logoUrl    String?
  maxMembers Int      @default(20)
  managerId  String   @unique

  manager User  @relation("ClubManager", fields: [managerId], references: [id], onDelete: Cascade)
  members User[] @relation("ClubMembers")

  @@index([managerId])
}

model Exercise {
  id         String            @id @default(uuid())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  sportId    String?
  title      String
  minPlayers Int?
  maxPlayers Int?
  difficulty Int
  videoLink  String?
  canvas     Json
  visibility ContentVisibility @default(private)
  creatorId  String?

  sport              Sport?                  @relation(fields: [sportId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator            User?                   @relation(fields: [creatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  trainingClassItems TrainingClassExercise[]

  @@index([sportId])
  @@index([creatorId])
  @@index([visibility])
}

model TrainingClass {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  title       String
  description String?
  sportId     String?
  difficulty  Int
  visibility  ContentVisibility @default(private)
  creatorId   String?

  sport   Sport?                  @relation(fields: [sportId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creator User?                   @relation(fields: [creatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items   TrainingClassExercise[]

  @@index([sportId])
  @@index([creatorId])
  @@index([visibility])
}

model TrainingClassExercise {
  id              String  @id @default(uuid())
  trainingClassId String
  exerciseId      String
  sortOrder       Int
  durationMinutes Int?
  isOptional      Boolean @default(false)

  trainingClass TrainingClass @relation(fields: [trainingClassId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([trainingClassId, exerciseId])
  @@index([trainingClassId, sortOrder])
}

model Sport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  slug      String

  exercises       Exercise[]
  elements        Element[]
  trainingClasses TrainingClass[]
}

model Element {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sportId   String?
  name      String
  type      String   @default("image")
  image     String
  width     Float
  height    Float

  sport Sport? @relation(fields: [sportId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([sportId])
}

model User {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  phoneNumber   String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  role          Role      @default(coach)
  avatarUrl     String?
  clubId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  club            Club?       @relation("ClubMembers", fields: [clubId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  managedClub     Club?       @relation("ClubManager")
  authTokens      AuthToken[]
  exercises       Exercise[]
  trainingClasses TrainingClass[]

  @@index([clubId])
  @@index([role])
}

model AuthToken {
  userId  String
  type    AuthTokenType
  token   String        @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}
